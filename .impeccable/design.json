      "html": "<div class=\"ds-prompt\"><label for=\"ds-command\"><span>visitante@jorge</span> <b>~</b> $</label><input id=\"ds-command\" placeholder=\"Escribe un comando…\" aria-label=\"Escribe un comando\"></div>",
